{
  "expo": {
    "name": "Ortecap",
    "slug": "ortecap-iphone",
    "scheme": "ortecapapp",
    "version": "6.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "web"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "cl.ortecap.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ortecap usa tu ubicación para registrar el recorrido (hoja de ruta) de tus clases prácticas de conducción.",
        "NSCameraUsageDescription": "Ortecap usa la cámara para adjuntar documentos y comprobantes.",
        "NSPhotoLibraryUsageDescription": "Ortecap necesita acceso a tus fotos para adjuntar documentos y comprobantes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ortecap usa tu ubicación para registrar el recorrido (hoja de ruta) de tus clases prácticas de conducción."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28389603-b587-4281-973f-738e1b232066"
      }
    }
  }
}
